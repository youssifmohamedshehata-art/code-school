<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الاشتراك في الكورس</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="register-box">
    <h2>الاشتراك في الكورس</h2>

    <form>

        <input type="text" placeholder="الاسم بالكامل" required>

        <input type="email" placeholder="البريد الإلكتروني" required>

        <input type="tel" placeholder="رقم الهاتف" required>

        <select required>
            <option>اختر الكورس</option>
            <option>HTML - 400 جنيه</option>
            <option>CSS - 450 جنيه</option>
            <option>JavaScript - 600 جنيه</option>
            <option>Python - 800 جنيه</option>
        </select>

        <button type="submit">اشترك الآن</button>

    </form>

</div>

</body>
</html>
